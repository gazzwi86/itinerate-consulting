{
  "name": "itinerate-consulting",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync-notion": "npx tsx scripts/sync-from-notion.ts",
    "deploy": "npm run build && aws s3 sync dist/ s3://itinerateconsulting-website --delete --profile gazzwi86 && aws cloudfront create-invalidation --distribution-id E9P3PRXXBCWXS --paths '/*' --profile gazzwi86",
    "test:ui": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write src",
    "prepare": "npx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run build"
  },
  "lint-staged": {
    "src/**/*.{ts,astro}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@notionhq/client": "^5.22.0",
    "astro": "^6.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "typescript-eslint": "^8.61.0"
  }
}
