---
import { SOCIAL } from '../config/site'

const year = new Date().getFullYear()

const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'About' },
  { href: '/writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
]

const socialLinks = [
  { href: SOCIAL.linkedin, label: 'LinkedIn' },
  { href: SOCIAL.substack, label: 'Substack' },
  { href: SOCIAL.medium, label: 'Medium' },
]
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="Home">
        <svg width="28" height="28" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <rect width="40" height="40" rx="9" fill="#5B6AD0"/>
          <rect x="17" y="19" width="6" height="14" rx="2" fill="white"/>
          <rect x="17" y="10" width="6" height="6" rx="2" fill="#6BCFBA"/>
        </svg>
        <span>itinerate</span>
      </a>
      <p>Technology leadership for teams building with AI.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <div>
        <h3>Pages</h3>
        <ul>
          {navLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Writing</h3>
        <ul>
          {socialLinks.map(l => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer-bottom container">
    <p>© {year} Itinerate Consulting. All rights reserved.</p>
    <p>Based in Australia. Working globally.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .footer-brand p {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 28ch;
  }

  .footer-nav {
    display: flex;
    gap: 3rem;
  }

  .footer-nav h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .footer-nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: var(--text);
    font-size: 0.9rem;
    transition: color 0.15s;
  }

  .footer-nav a:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; gap: 0.25rem; text-align: center; }
  }
</style>
