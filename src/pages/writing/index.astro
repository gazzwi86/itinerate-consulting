---
import Base from '../../layouts/Base.astro'
import { getSortedPosts, postSlug } from '../../lib/posts'
import PostCard from '../../components/PostCard.astro'
import { SOCIAL } from '../../config/site'

const posts = await getSortedPosts()

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort()
---

<Base
  title="Writing"
  description="Notes on agentic engineering, AI in production and the practice of technology leadership - by Gareth Williams."
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Writing</span>
      <h1>Thinking out loud.</h1>
      <p>Notes on agentic engineering, AI in production and the practice of technology leadership. Published on Substack and Medium.</p>
      <div class="writing-links">
        <a href="https://substack.com/@prompttoprod" target="_blank" rel="noopener noreferrer" class="btn">
          Follow on Substack →
        </a>
        <a href={SOCIAL.medium} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Medium
        </a>
      </div>
    </div>
  </section>

  <section class="container posts-section">
    {allTags.length > 0 && (
      <div class="tags-filter" aria-label="Topics covered">
        <span>Topics:</span>
        {allTags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    )}

    <div class="posts-grid">
      {posts.map(post => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          summary={post.data.summary}
          canonicalUrl={post.data.canonicalUrl}
          platform={post.data.platform}
          tags={post.data.tags}
          slug={postSlug(post.id)}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="empty-state">
        <p>No posts yet. Check back soon.</p>
        <a href="https://substack.com/@prompttoprod" target="_blank" rel="noopener noreferrer" class="btn">
          Follow on Substack →
        </a>
      </div>
    )}
  </section>
</Base>

<style>
  .page-hero {
    padding: 5rem 0 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .page-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0.5rem 0 0.75rem;
  }

  .page-hero p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 52ch;
    margin-bottom: 1.5rem;
  }

  .writing-links { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .posts-section { padding: 3.5rem 0 6rem; }

  .tags-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--muted);
    font-family: 'Space Grotesk', sans-serif;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 1.25rem;
  }

  /* Single card spans full width so it doesn't look orphaned */
  .posts-grid > :only-child {
    max-width: 680px;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    color: var(--muted);
  }

  /* .section-label lives in global.css */
</style>
