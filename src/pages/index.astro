---
import Base from '../layouts/Base.astro'
import { getSortedPosts, postSlug } from '../lib/posts'
import PostCard from '../components/PostCard.astro'
import { SOCIAL, CONTACT_EMAIL } from '../config/site'

const posts = (await getSortedPosts()).slice(0, 3)

const services = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M3 12h1m8-9v1m8 8h1m-9 8v1M5.6 5.6l.7.7m12.1-.7-.7.7m.7 11.4-.7-.7M6.3 18.4l-.7.7"/></svg>`,
    title: 'Agentic engineering',
    desc: 'Designing and building AI agent systems, evaluation frameworks and production pipelines. From proof-of-concept to something that ships.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Engineering leadership',
    desc: 'Interim and fractional CTO. Scaling teams, establishing engineering practices and driving delivery when it matters most.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    title: 'Hiring and team building',
    desc: 'Sourcing, assessing and onboarding engineering talent at every level. Finding the right people and setting them up to succeed.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    title: 'Strategy and architecture',
    desc: 'AI readiness assessments, cloud architecture and DevSecOps for organisations modernising at pace. Practical, not theoretical.',
  },
]
---

<Base
  title="Itinerate Consulting"
  description="Technology leadership for engineering teams building with AI. Independent consultant specialising in agentic engineering, AI-native architecture and engineering leadership. Based in Australia."
>

  <!-- ── HERO ────────────────────────────────────────────────── -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <div class="hero-badge fade-up fade-up-1">
        <span class="tag">Available for new engagements</span>
      </div>
      <h1 class="hero-title fade-up fade-up-2">
        I help engineering teams<br />build and ship with AI.
      </h1>
      <p class="hero-sub fade-up fade-up-3">
        Gareth Williams. Independent consultant specialising in agentic engineering,
        AI-native architecture and the organisational side of getting AI into production.
      </p>
      <div class="hero-actions fade-up fade-up-4">
        <a href="#contact" class="btn">Get in touch →</a>
        <a href="#services" class="btn btn-ghost">What I do</a>
      </div>
    </div>
    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <!-- ── PROOF BELT ─────────────────────────────────────────── -->
  <div class="proof-belt">
    <div class="container proof-inner">
      <span class="proof-label">Writing on</span>
      <a href="https://substack.com/@prompttoprod" target="_blank" rel="noopener noreferrer" class="proof-link">Substack · Prompt to Prod</a>
      <span class="proof-sep" aria-hidden="true">·</span>
      <a href={SOCIAL.medium} target="_blank" rel="noopener noreferrer" class="proof-link">Medium</a>
      <span class="proof-sep" aria-hidden="true">·</span>
      <a href="https://www.linkedin.com/in/gareth-williams-solutions-consultant/" target="_blank" rel="noopener noreferrer" class="proof-link">LinkedIn</a>
      <span class="proof-sep proof-sep--wide" aria-hidden="true">·</span>
      <span class="proof-label">Based in Australia. Working globally.</span>
    </div>
  </div>

  <!-- ── SERVICES ───────────────────────────────────────────── -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header">
        <span class="section-label">What I do</span>
        <h2>How I can help</h2>
        <p>I work with engineering teams and leadership across the full arc - from strategy to shipping.</p>
      </div>
      <div class="services-grid">
        {services.map(s => (
          <div class="service-card">
            <div class="service-icon" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── ABOUT ──────────────────────────────────────────────── -->
  <section class="section section--surface" id="about">
    <div class="container about-inner">
      <div class="about-text">
        <div class="section-header">
          <span class="section-label">About</span>
          <h2>Gareth Williams.</h2>
        </div>
        <p>
          I built Itinerate Consulting on a simple premise: the best technology decisions
          come from people who have shipped real systems under real constraints. I work
          across strategy, architecture, delivery and leadership - often all at once.
        </p>
        <p>
          My focus right now is agentic engineering - the discipline of taking AI from a
          compelling demo to a system that runs reliably in production. That means evaluation
          frameworks, agent orchestration, human-in-the-loop design and the organisational
          changes that make it stick.
        </p>
        <p>
          I'm based in Australia and work with clients globally. Engagements range from
          short advisory stints to longer embedded partnerships.
        </p>
        <div class="about-links">
          <a href="https://www.linkedin.com/in/gareth-williams-solutions-consultant/" target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a href="https://substack.com/@prompttoprod" target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08zM1.46 10.812V24L12 18.11 22.54 24V10.812zM22.54 0H1.46v2.836h21.08z"/></svg>
            Substack
          </a>
          <a href={SOCIAL.medium} target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            Medium
          </a>
        </div>
      </div>
      <div class="about-avatar">
        <div class="avatar-initials" aria-hidden="true">GW</div>
        <div class="about-card">
          <h3>Engagements</h3>
          <ul>
            <li>Agentic engineering and AI systems</li>
            <li>Interim and fractional CTO</li>
            <li>Engineering hiring and team design</li>
            <li>Cloud architecture and DevSecOps</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WRITING ────────────────────────────────────────────── -->
  {posts.length > 0 && (
    <section class="section" id="writing">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Writing</span>
          <h2>Latest thinking.</h2>
          <p>Notes on agentic engineering, AI in production and the practice of technology leadership.</p>
        </div>
        <div class="posts-grid">
          {posts.map(post => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              canonicalUrl={post.data.canonicalUrl}
              platform={post.data.platform}
              tags={post.data.tags}
              slug={postSlug(post.id)}
            />
          ))}
        </div>
        <div class="section-cta">
          <a href="/writing" class="btn btn-ghost">All writing →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ── CONTACT ────────────────────────────────────────────── -->
  <section class="section section--surface" id="contact">
    <div class="container contact-inner">
      <div class="contact-text">
        <span class="section-label">Contact</span>
        <h2>Let's talk.</h2>
        <p>
          I'm selective about new engagements - I take on work where I can make a real
          difference. Tell me what you're building and where you're stuck.
        </p>
        <p>I typically respond within one business day.</p>

        <div class="contact-details">
          <div class="contact-item">
            <span class="contact-label">Email</span>
            <a href="#" class="contact-link" data-u={CONTACT_EMAIL.u} data-d={CONTACT_EMAIL.d}>
              {CONTACT_EMAIL.u} [at] {CONTACT_EMAIL.d}
            </a>
          </div>
          <div class="contact-item">
            <span class="contact-label">LinkedIn</span>
            <a href="https://www.linkedin.com/in/gareth-williams-solutions-consultant/" target="_blank" rel="noopener noreferrer" class="contact-link">
              gareth-williams-solutions-consultant →
            </a>
          </div>
        </div>
      </div>

      <div class="contact-card">
        <h3>What to include</h3>
        <ul>
          <li>What you're building or trying to solve</li>
          <li>The scale and timeline you're working to</li>
          <li>Whether you need advisory or something longer</li>
          <li>Your role and who else is involved</li>
        </ul>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 760px;
  }

  .hero-badge { margin-bottom: 0.125rem; }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 54ch;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .hero-glow {
    position: absolute;
    top: -160px;
    right: -200px;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(91, 106, 208, 0.1) 0%, transparent 65%);
    pointer-events: none;
  }

  /* Proof belt */
  .proof-belt {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 0.875rem 0;
  }

  .proof-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: 0.85rem;
  }

  .proof-label { color: var(--muted); font-family: 'Space Grotesk', sans-serif; font-weight: 500; }

  .proof-link {
    color: var(--text);
    font-weight: 500;
    font-family: 'Space Grotesk', sans-serif;
    transition: color 0.15s;
  }

  .proof-link:hover { color: var(--accent); }
  .proof-sep { color: var(--border); font-weight: 700; }
  .proof-sep--wide { display: none; }

  @media (min-width: 640px) { .proof-sep--wide { display: inline; } }

  /* Shared section styles */
  .section { padding: 5.5rem 0; }
  .section--surface { background: var(--surface); }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 3rem;
    max-width: 560px;
  }

  /* .section-label lives in global.css */

  .section-header h2 { font-size: clamp(1.75rem, 3vw, 2.375rem); }

  .section-header p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  /* Services */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.125rem;
  }

  .service-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.625rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .service-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow-accent);
    transform: translateY(-2px);
  }

  .service-icon {
    width: 40px;
    height: 40px;
    background: var(--accent-light);
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    flex-shrink: 0;
    margin-bottom: 0.25rem;
  }

  .service-card h3 { font-size: 1rem; font-weight: 600; }

  .service-card p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    max-width: none;
  }

  /* About */
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-text p {
    color: var(--muted);
    line-height: 1.75;
    max-width: 60ch;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .about-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.875rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    transition: border-color 0.15s, color 0.15s;
  }

  .about-social-link:hover { border-color: var(--accent); color: var(--accent); }

  .about-avatar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 5rem;
  }

  .avatar-initials {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--accent) 0%, #7B87E0 100%);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.02em;
    box-shadow: var(--shadow-accent);
  }

  .about-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
  }

  .about-card h3 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .about-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-card li {
    font-size: 0.875rem;
    color: var(--text);
    padding-left: 1rem;
    position: relative;
    line-height: 1.4;
  }

  .about-card li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--mint);
    font-size: 0.75rem;
    top: 0.1em;
  }

  /* Writing */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 1.125rem;
  }

  .section-cta { margin-top: 2.25rem; }

  /* Contact */
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .contact-text h2 { font-size: clamp(1.75rem, 3vw, 2.375rem); margin: 0.25rem 0; }

  .contact-text p { color: var(--muted); line-height: 1.7; max-width: 52ch; }

  .contact-details { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1rem; }

  .contact-item { display: flex; flex-direction: column; gap: 0.2rem; }

  .contact-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .contact-link {
    font-size: 1rem;
    color: var(--accent);
    transition: opacity 0.15s;
    word-break: break-all;
  }

  .contact-link:hover { opacity: 0.75; }

  .contact-card {
    background: var(--accent-light);
    border-radius: var(--radius);
    padding: 1.5rem;
    position: sticky;
    top: 5rem;
  }

  .contact-card h3 {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .contact-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .contact-card li {
    font-size: 0.9rem;
    color: var(--muted);
    padding-left: 1rem;
    position: relative;
    line-height: 1.4;
  }

  .contact-card li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .about-inner,
    .contact-inner { grid-template-columns: 1fr; }
    .about-avatar { position: static; flex-direction: row; align-items: flex-start; }
    .contact-card { position: static; }
  }
</style>
