---
import Base from '../layouts/Base.astro'
import { getSortedPosts, postSlug } from '../lib/posts'
import PostCard from '../components/PostCard.astro'
import { SOCIAL, CONTACT_EMAIL } from '../config/site'

const posts = await getSortedPosts()

const testimonials = [
  // { quote: '...', author: 'Name', role: 'Title, Company' },
]

const talks = [
  {
    title: 'Comprehension debt',
    desc: 'When AI writes faster than your team can understand - the structural risk no one is pricing in.',
    href: '/topics/comprehension-debt',
  },
  {
    title: 'Your AI has your keys',
    desc: 'The employee-clone problem - non-human identity and why AI agents need their own security model.',
    href: '/topics/ai-governance',
  },
  {
    title: 'Ontologies for agents',
    desc: 'Why your AI stalls without a model of your business - and how to build one.',
    href: '/topics/ai-native-architecture',
  },
  {
    title: 'Agentic engineering',
    desc: 'The craft nobody is teaching yet - what changes when you design the system that writes the code.',
    href: '/topics/agentic-engineering',
  },
  {
    title: 'Prototype-driven development',
    desc: 'An SDLC for the AI age - the best spec is a tested prototype, not a document.',
    href: '/topics/engineering-craft',
  },
]
---

<Base
  title="Gareth Williams - Agentic Engineering Writer"
  description="Gareth Williams writes Prompt to Prod and speaks about agentic engineering, AI governance and what it takes to ship AI in production. Writer, speaker, practitioner."
>

  <!-- ── HERO ────────────────────────────────────────────────── -->
  <section class="hero" id="home">
    <div class="container hero-inner">
      <h1 class="hero-title fade-up fade-up-1">
        I build with AI.<br />I write about what that actually changes.
      </h1>
      <p class="hero-sub fade-up fade-up-2">
        Gareth Williams. Writer of
        <a href={`${SOCIAL.newsletter}?utm_source=itinerate&utm_medium=referral&utm_campaign=home-hero`} target="_blank" rel="noopener noreferrer" class="hero-inline-link">Prompt to Prod</a>
        and practitioner with 15+ years building software across banking, energy, government and retail.
        Now focused on agentic engineering, AI governance and what it takes to ship AI in production. No hype.
      </p>
      <div class="hero-actions fade-up fade-up-3">
        <a href="#writing" class="btn">Read the writing <span aria-hidden="true">→</span></a>
        <a href={`${SOCIAL.newsletter}?utm_source=itinerate&utm_medium=referral&utm_campaign=home-hero`} target="_blank" rel="noopener noreferrer" class="hero-sub-link">Subscribe to Prompt to Prod <span aria-hidden="true">→</span></a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <!-- ── PROOF BELT ─────────────────────────────────────────── -->
  <div class="proof-belt">
    <div class="container proof-inner">
      <span class="proof-label">Writing on</span>
      <a href={`${SOCIAL.newsletter}?utm_source=itinerate&utm_medium=referral&utm_campaign=proof-belt`} target="_blank" rel="noopener noreferrer" class="proof-link">Substack · Prompt to Prod</a>
      <span class="proof-sep" aria-hidden="true">·</span>
      <a href={SOCIAL.medium} target="_blank" rel="noopener noreferrer" class="proof-link">Medium</a>
      <span class="proof-sep" aria-hidden="true">·</span>
      <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="proof-link">LinkedIn</a>
      <span class="proof-sep proof-sep--wide" aria-hidden="true">·</span>
      <span class="proof-label">Based in Australia. Working globally.</span>
    </div>
  </div>

  <!-- ── WIRE DIVIDER ─────────────────────────────────────────── -->
  <div class="wire-divider" aria-hidden="true">
    <svg viewBox="0 0 1100 2" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="1" x2="1100" y2="1" stroke="url(#wire-grad)" stroke-width="1.5" class="wire-line"/>
      <defs>
        <linearGradient id="wire-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="transparent"/>
          <stop offset="30%" stop-color="#5B6AD0" stop-opacity="0.6"/>
          <stop offset="70%" stop-color="#6BCFBA" stop-opacity="0.6"/>
          <stop offset="100%" stop-color="transparent"/>
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- ── WRITING ────────────────────────────────────────────── -->
  {posts.length > 0 && (
    <section class="section" id="writing">
      <div class="container">
        <div class="section-header">
          <span class="section-label">Writing</span>
          <h2>Writing.</h2>
          <p>Notes from building AI in production - not theory, not hype.</p>
        </div>
        <div class="posts-grid">
          {posts.map(post => (
            <PostCard
              title={post.data.title}
              date={post.data.date}
              summary={post.data.summary}
              canonicalUrl={post.data.canonicalUrl}
              platform={post.data.platform}
              tags={post.data.tags}
              slug={postSlug(post.id)}
            />
          ))}
        </div>
        <div class="newsletter-embed newsletter-embed--writing">
          <p class="section-label newsletter-label">Get Prompt to Prod in your inbox</p>
          <form class="newsletter-form" action="https://prompttoprod.substack.com/api/v1/free" method="post" target="_blank">
            <input type="hidden" name="first_url" value="https://itinerateconsulting.com">
            <input type="hidden" name="first_referrer" value="">
            <div class="newsletter-row">
              <input type="email" name="email" placeholder="your@email.com" required class="newsletter-input" aria-label="Email address">
              <button type="submit" class="btn newsletter-btn">Subscribe</button>
            </div>
            <p class="newsletter-fine">Free newsletter. Unsubscribe any time.</p>
          </form>
        </div>
      </div>
    </section>
  )}

  <!-- ── SPEAKING ────────────────────────────────────────────── -->
  <section class="section section--surface" id="speaking">
    <div class="container">
      <div class="section-header section-header--wide">
        <span class="section-label">Speaking & podcasts</span>
        <h2>Let's talk about what AI actually changes.</h2>
        <p>
          I write and speak about what AI means for the people building software - the craft,
          the architecture, the governance and the risks most adoption skips. Plain,
          practitioner, no hype. Based in Australia; happy to do remote podcasts and talks
          anywhere, in-person around Melbourne.
        </p>
      </div>

      <div class="talks-grid">
        {talks.map(t => (
          <a href={t.href} class="talk-card">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </a>
        ))}
      </div>

      <div class="speaking-ctas">
        <a href="#contact" class="btn">Invite me on your podcast <span aria-hidden="true">→</span></a>
        <a href="#contact" class="btn btn-ghost">Book me to speak</a>
        <a href="#contact" class="btn btn-ghost">Commission a guest piece</a>
      </div>

      <div class="speaking-bio">
        <p class="bio-label">Copy-paste bio (50 words)</p>
        <blockquote class="bio-block">
          Gareth Williams is a Principal Solutions Architect and the writer behind Prompt to Prod.
          He has spent 15+ years building software across banking, energy, government and retail,
          and now focuses on agentic engineering and AI governance. He writes and speaks about what
          AI actually changes for engineering teams, not the hype.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ── LOGOS BELT ───────────────────────────────────────── -->
  <div class="logos-belt">
    <div class="container">
      <span class="logos-label">Experience across</span>
      <div class="logos-row">
        <span class="logo-chip">Burberry</span>
        <span class="logo-chip">Westpac</span>
        <span class="logo-chip">Lloyds Banking Group</span>
        <span class="logo-chip">Shell Energy</span>
        <span class="logo-chip">Vic. Dept of Transport</span>
        <span class="logo-chip">Colonial First State</span>
      </div>
    </div>
  </div>

  <!-- ── TESTIMONIALS ──────────────────────────────────────── -->
  {testimonials.length > 0 && (
    <section class="section" id="testimonials">
      <div class="container">
        <div class="section-header">
          <span class="section-label">What people say</span>
          <h2>Kind words.</h2>
        </div>
        <div class="testimonials-grid">
          {testimonials.map(t => (
            <figure class="testimonial-card sidebar-card">
              <blockquote>
                <p>"{t.quote}"</p>
              </blockquote>
              <figcaption>
                <strong>{t.author}</strong>
                <span>{t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── ADVISORY ───────────────────────────────────────────── -->
  <section class="section advisory-section" id="services">
    <div class="container">
      <div class="advisory-inner">
        <span class="section-label">Advisory</span>
        <p class="advisory-text">I take on the occasional advisory engagement - usually agentic engineering strategy, AI governance or getting AI systems from proof-of-concept to production. If that is useful to you, <a href="#contact" class="advisory-link">get in touch</a>.</p>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ──────────────────────────────────────────────── -->
  <section class="section section--surface" id="about">
    <div class="container about-inner">
      <div class="about-text">
        <div class="section-header">
          <span class="section-label">About</span>
          <h2>Gareth Williams.</h2>
        </div>
        <p>
          I've spent 15+ years building software across financial services, energy, government,
          eCommerce and health, for organisations including Westpac, Lloyds Banking Group and
          Shell Energy. I write the Prompt to Prod newsletter and speak about what AI is doing
          to the craft of software.
        </p>
        <p>
          My current focus is agentic engineering and AI governance - the discipline of taking
          AI from a compelling demo to a system that runs reliably in production, and the
          organisational and ethical side of getting that right.
        </p>
        <p>
          Based in Australia. Working globally.
        </p>
        <div class="about-links">
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a href={`${SOCIAL.newsletter}?utm_source=itinerate&utm_medium=referral&utm_campaign=about`} target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22.539 8.242H1.46V5.406h21.08zM1.46 10.812V24L12 18.11 22.54 24V10.812zM22.54 0H1.46v2.836h21.08z"/></svg>
            Prompt to Prod
          </a>
          <a href={SOCIAL.medium} target="_blank" rel="noopener noreferrer" class="about-social-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            Medium
          </a>
        </div>
      </div>
      <div class="about-avatar">
        <div class="about-card sidebar-card">
          <h3>Currently</h3>
          <ul>
            <li>Writing Prompt to Prod weekly</li>
            <li>Speaking on agentic engineering and AI governance</li>
            <li>Building agent systems that ship to production</li>
            <li>Based in Melbourne, working globally</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CONTACT ────────────────────────────────────────────── -->
  <section class="section section--surface" id="contact">
    <div class="container contact-inner">
      <div class="contact-text">
        <span class="section-label">Contact</span>
        <h2>Let's talk.</h2>
        <p>
          I'm open to podcast appearances, speaking, guest writing and the occasional
          advisory engagement. Tell me what you're working on.
        </p>
        <p>I typically respond within one business day.</p>

        <form id="contact-form" class="contact-form" action="https://formspree.io/f/REPLACE_ME" method="POST">
          <input type="text" name="_gotcha" tabindex="-1" aria-hidden="true" style="display:none">

          <div class="form-field">
            <label for="cf-name" class="form-label">Name <span class="form-required" aria-hidden="true">*</span></label>
            <input type="text" id="cf-name" name="name" required class="form-input" autocomplete="name">
          </div>

          <div class="form-field">
            <label for="cf-email" class="form-label">Email <span class="form-required" aria-hidden="true">*</span></label>
            <input type="email" id="cf-email" name="email" required class="form-input" autocomplete="email">
          </div>

          <div class="form-field">
            <label for="cf-org" class="form-label">Organisation</label>
            <input type="text" id="cf-org" name="organisation" class="form-input" autocomplete="organization">
          </div>

          <div class="form-field">
            <label for="cf-type" class="form-label">Enquiry type <span class="form-required" aria-hidden="true">*</span></label>
            <select id="cf-type" name="enquiry_type" required class="form-input form-select">
              <option value="" disabled selected>Select...</option>
              <option value="Podcast appearance">Podcast appearance</option>
              <option value="Speaking engagement">Speaking engagement</option>
              <option value="Guest piece">Guest piece</option>
              <option value="Advisory">Advisory</option>
              <option value="Other">Other / General enquiry</option>
            </select>
          </div>

          <div class="form-field">
            <label for="cf-message" class="form-label">What you're working on <span class="form-required" aria-hidden="true">*</span></label>
            <textarea id="cf-message" name="message" required rows="4" class="form-input form-textarea" placeholder="Tell me what you're building or working on..."></textarea>
          </div>

          <div class="form-field">
            <label for="cf-timeline" class="form-label">Timeline</label>
            <input type="text" id="cf-timeline" name="timeline" class="form-input" placeholder="e.g. next month, Q3, open">
          </div>

          <div class="form-actions">
            <button type="submit" class="btn">Send enquiry</button>
            <p id="form-error" class="form-error-msg" aria-live="polite"></p>
          </div>
          <p class="form-note">You'll get a reply within one business day.</p>
        </form>

        <p class="contact-fallback">
          Or email directly:
          <a href="#" class="contact-link" data-u={CONTACT_EMAIL.u} data-d={CONTACT_EMAIL.d}>
            {CONTACT_EMAIL.u} [at] {CONTACT_EMAIL.d}
          </a>
        </p>
      </div>

      <div class="contact-card sidebar-card">
        <h3>Good to know</h3>
        <ul>
          <li>Most enquiries get a reply same day</li>
          <li>Remote podcasts and talks work well - based in Melbourne</li>
          <li>For advisory, typical engagements are 4 - 6 weeks with a written output</li>
          <li>No intake forms, no sales calls - just a conversation</li>
        </ul>
      </div>
    </div>
  </section>


<script>
/* ── WIRE DIVIDER TRACE ─────────────────────────────────── */
const wire = document.querySelector('.wire-divider')
if (wire) {
  const wo = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) { wire.classList.add('traced'); wo.disconnect() }
  }, { threshold: 0.5 })
  wo.observe(wire)
}

/* ── CONTACT FORM (Formspree AJAX) ──────────────────────── */
const form = document.getElementById('contact-form')
if (form) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Sending...'
    try {
      const res = await fetch((form as HTMLFormElement).action, {
        method: 'POST',
        body: new FormData(form as HTMLFormElement),
        headers: { Accept: 'application/json' },
      })
      if (res.ok) {
        form.innerHTML = '<div class="form-success"><p>Thanks - I\'ll be in touch within one business day.</p></div>'
      } else {
        btn.disabled = false
        btn.textContent = 'Send enquiry'
        const errEl = document.getElementById('form-error')
        if (errEl) errEl.textContent = 'Something went wrong. Please try emailing directly.'
      }
    } catch {
      btn.disabled = false
      btn.textContent = 'Send enquiry'
      const errEl = document.getElementById('form-error')
      if (errEl) errEl.textContent = 'Could not reach the server. Please try emailing directly.'
    }
  })
}
</script>

</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-sub {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 54ch;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .hero-inline-link {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: rgba(91,106,208,0.35);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s;
  }
  .hero-inline-link:hover { text-decoration-color: var(--accent); }
  .hero-sub-link { color: var(--accent); font-size: 0.9rem; text-decoration: underline; text-decoration-color: rgba(91,106,208,0.35); text-underline-offset: 2px; transition: text-decoration-color 0.15s; }
  .hero-sub-link:hover { text-decoration-color: var(--accent); }

  /* Wire divider */
  .wire-divider {
    overflow: hidden;
    line-height: 0;
    height: 2px;
  }

  .wire-divider svg {
    display: block;
    width: 100%;
    height: 2px;
  }

  .wire-line {
    stroke-dasharray: 1100;
    stroke-dashoffset: 1100;
    transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wire-divider.traced .wire-line {
    stroke-dashoffset: 0;
  }

  /* Proof belt */
  .proof-belt {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 0.875rem 0;
  }

  .proof-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem;
    font-size: 0.85rem;
  }

  .proof-label { color: var(--muted); font-family: 'Space Grotesk', sans-serif; font-weight: 500; }

  .proof-link {
    color: var(--text);
    font-weight: 500;
    font-family: 'Space Grotesk', sans-serif;
    transition: color 0.15s;
  }

  .proof-link:hover { color: var(--accent); }
  .proof-sep { color: var(--border); font-weight: 700; }
  .proof-sep--wide { display: none; }

  @media (min-width: 640px) { .proof-sep--wide { display: inline; } }

  /* Shared section styles */
  .section { padding: 5.5rem 0; }
  .section--surface { background: var(--surface); }

  /* Contact sits last — trim excess bottom space */
  #contact.section { padding-bottom: 4rem; }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 3rem;
    max-width: 560px;
  }

  /* .section-label lives in global.css */

  .section-header h2 { font-size: clamp(1.75rem, 3vw, 2.375rem); }

  .section-header p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 52ch;
  }

  /* Advisory */
  .advisory-section { padding: 2.5rem 0; }
  .advisory-inner { display: flex; flex-direction: column; gap: 0.75rem; max-width: 640px; }
  .advisory-text { font-size: 1.0625rem; color: var(--muted); line-height: 1.7; }
  .advisory-link { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(91,106,208,0.35); }
  .advisory-link:hover { text-decoration-color: var(--accent); }

  /* About */
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-text p {
    color: var(--muted);
    line-height: 1.75;
    max-width: 60ch;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .about-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.875rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
    transition: border-color 0.15s, color 0.15s;
  }

  .about-social-link:hover { border-color: var(--accent); color: var(--accent); }

  .about-avatar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 5rem;
  }

  .about-card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--mint);
    font-size: 0.8rem;
    font-weight: 700;
    top: 0.05em;
  }

  /* Writing */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 1.125rem;
  }

  .section-cta { margin-top: 2.25rem; }

  /* Contact */
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
    align-items: start;
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .contact-text h2 { font-size: clamp(1.75rem, 3vw, 2.375rem); margin: 0.25rem 0; }

  .contact-text p { color: var(--muted); line-height: 1.7; max-width: 52ch; }

  .contact-details { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 1rem; }

  .contact-item { display: flex; flex-direction: column; gap: 0.2rem; }

  .contact-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .contact-link {
    font-size: 1rem;
    color: var(--accent);
    transition: opacity 0.15s;
    word-break: break-all;
  }

  .contact-link:hover { opacity: 0.75; }

  .contact-card {
    position: sticky;
    top: 5rem;
  }

  .contact-card li { counter-increment: card-item; }

  .contact-card li::before {
    content: counter(card-item);
